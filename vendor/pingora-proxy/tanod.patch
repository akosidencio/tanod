+/// Tanod patch: account for response tasks that are drained rather than written.
+///
+/// Returns whether the response ended. A failed task carries the upstream's error and
+/// is surfaced as writing it would have surfaced it.
+pub(crate) fn drained_tasks(
+    tasks: Vec<pingora_core::protocols::http::HttpTask>,
+) -> Result<bool> {
+    let mut end = false;
+    for task in tasks {
+        if let pingora_core::protocols::http::HttpTask::Failed(e) = task {
+            return Err(e);
+        }
+        end |= task.is_end();
+    }
+    Ok(end)
+}
