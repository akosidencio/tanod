index d675c33..bc74d98 100644
--- a/src/proxy_trait.rs
+++ b/src/proxy_trait.rs
@@ -574,6 +574,30 @@ pub trait ProxyHttp {
         false
     }
 
+    /// Keep receiving the upstream response after the downstream fails, until `deadline`.
+    ///
+    /// While a response is filling the cache, Pingora already ignores a downstream error and
+    /// finishes reading the upstream response. Every other response is abandoned on that
+    /// error, which closes the upstream connection (or resets its HTTP/2 stream) at once.
+    ///
+    /// Returning `Some(deadline)` applies the cache-fill behaviour to this request: the
+    /// downstream is marked errored, the upstream response is still read and still passes
+    /// through the upstream filters, its bytes are discarded rather than written, and the
+    /// exchange fails with a timeout if it has not ended by `deadline`. `None`, the default,
+    /// keeps the existing behaviour.
+    ///
+    /// Consulted only once the downstream request body has been read completely, and never
+    /// for an upgraded session.
+    ///
+    /// Local patch carried by Tanod; see `vendor/pingora-proxy/TANOD-PATCH.md`.
+    fn upstream_after_downstream_error(
+        &self,
+        _session: &Session,
+        _ctx: &mut Self::CTX,
+    ) -> Option<std::time::Instant> {
+        None
+    }
+
