+    /// Tanod patch: decide whether this downstream error abandons the upstream exchange.
+    ///
+    /// `Ok` means the error was absorbed: the downstream is marked errored, `drain_until` is
+    /// set, and the caller carries on reading the upstream response. `Err` returns the
+    /// original error, which abandons the exchange exactly as Pingora always has.
+    pub(crate) fn drain_after_downstream_error(
+        &self,
+        session: &mut Session,
+        ctx: &mut SV::CTX,
+        downstream_state: &mut DownstreamStateMachine,
+        e: Box<Error>,
+        drain_until: &mut Option<std::time::Instant>,
+    ) -> Result<()>
+    where
+        SV: ProxyHttp + Send + Sync,
+        SV::CTX: Send + Sync,
+    {
+        if drain_until.is_some() {
+            return Ok(());
+        }
+        // A request body still arriving cannot be completed for the origin, and a
+        // tunnel has no response to finish.
+        if downstream_state.is_reading() || session.was_upgraded() {
+            return Err(e);
+        }
+        let Some(deadline) = self.inner.upstream_after_downstream_error(session, ctx) else {
+            return Err(e);
+        };
+        debug!(
+            "Downstream error, draining upstream response: {}, {}",
+            e,
+            self.inner.request_summary(session, ctx)
+        );
+        downstream_state.to_errored();
+        *drain_until = Some(deadline);
+        session.downstream_session.on_proxy_failure(e);
+        Ok(())
+    }
